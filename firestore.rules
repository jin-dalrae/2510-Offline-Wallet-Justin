rules_version = '2';

// Threat model:
// - Firebase signs users in anonymously or via Google. `request.auth.uid` is
//   the only authenticated identity we can trust at the rules layer.
// - Wallet addresses live in the client wallet; Firestore can't verify wallet
//   ownership without a backend (Cloud Functions minting custom tokens).
//   Until that's wired, we use `ownerUid == request.auth.uid` as the access
//   control predicate on every user-owned document.
// - Admins are tracked in `admins/{uid}`. Membership is the *only* way to
//   gain admin powers. Never trust a `role` field on the user doc.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function owns(resourceData) {
      return isSignedIn() && resourceData.ownerUid == request.auth.uid;
    }

    function incomingOwnerMatches() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // ===== Users =====
    // Each user doc is identified by either `google_{uid}` (Google flow) or a
    // username chosen at sign-up. In both cases, on create we require the
    // ownerUid field to match the caller. The encryptedWallet field is itself
    // password-protected so we tolerate broader read access for the owner only.
    match /users/{userId} {
      allow create: if incomingOwnerMatches() &&
        // For Google flow, doc id must match auth uid
        (userId == ('google_' + request.auth.uid) || true);

      allow read, update: if owns(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===== Pending transactions / vouchers =====
    // Either the sender or receiver should be able to read & advance the doc.
    // We record both uids when the doc is created.
    match /pending_transactions/{transactionId} {
      allow read: if isAdmin() ||
        (isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid
        ));

      allow create: if isSignedIn() &&
        // Caller must claim to be either sender or receiver
        (request.resource.data.senderUid == request.auth.uid ||
         request.resource.data.receiverUid == request.auth.uid) &&
        request.resource.data.keys().hasAll(['from', 'to', 'amount', 'status']);

      allow update: if isAdmin() ||
        (isSignedIn() &&
         (resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid) &&
         request.resource.data.status in ['pending', 'settled', 'failed']);

      allow delete: if isAdmin();
    }

    // ===== Audit log (append-only) =====
    match /admin_audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ===== Admin registry =====
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ===== Multi-wallet metadata (no secrets) =====
    match /wallets/{walletId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if incomingOwnerMatches();
      allow update, delete: if isAdmin() || owns(resource.data);
    }
  }
}
