# Vite reads VITE_* keys at build time and bakes them into the bundle.
# Copy this file to `.env` (or `.env.local`) and fill in real values.

# ===== Base Sepolia network =====
# Override the public RPC with your own (Coinbase Developer Platform, Alchemy, etc.)
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org

# ===== Token contracts on Base Sepolia =====
# Leave blank to use the defaults compiled into src/lib/blockchain.ts.
VITE_USDC_CONTRACT_ADDRESS=
VITE_EURC_CONTRACT_ADDRESS=
VITE_CBBTC_CONTRACT_ADDRESS=

# ===== Firebase (optional; the app works offline-only without these) =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== AI agent backend (optional) =====
VITE_AGENT_API_URL=http://localhost:8000
