{
  "name": "offline-stablecoin-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios": "npm run ios:sync && npx cap open ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat run scripts/verify-contract.ts",
    "contract:deploy": "hardhat run scripts/deploy.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@x402/evm": "^2.2.0",
    "@x402/fetch": "^2.2.0",
    "ethers": "^6.9.0",
    "firebase": "^10.14.1",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.5.1",
    "uuid": "^9.0.1",
    "viem": "^2.44.2",
    "x402": "^1.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@nomicfoundation/hardhat-ethers": "^4.0.11",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.8",
    "@nomicfoundation/hardhat-keystore": "^3.0.9",
    "@nomicfoundation/hardhat-mocha": "^3.0.19",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.8.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "hardhat": "^3.4.5",
    "mocha": "^11.7.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-node-polyfills": "^0.19.0"
  }
}
